# Copia este archivo a .env.local y llena los valores reales.
# Los encuentras en supabase.com -> tu proyecto -> Project Settings -> API

# Públicas: van al navegador, están protegidas por las políticas RLS
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima

# PRIVADA: la "service_role" key. Solo la usa el servidor.
# ⚠️ NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
